{
  "name": "yubal",
  "short_name": "yubal",
  "description": "Self-hosted YouTube Music downloader",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#100F0F",
  "theme_color": "#3AA99F",
  "icons": [
    {
      "src": "./favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
